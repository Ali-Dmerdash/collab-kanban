{
  "name": "collab-kanban",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev:backend": "bun run --filter backend dev",
    "dev:frontend": "bun run --filter frontend dev",
    "dev": "bun run --parallel dev:backend dev:frontend",
    "test": "bun run --filter backend test",
    "build": "bun run --filter backend build && bun run --filter frontend build",
    "prisma:generate": "bun run --filter backend prisma:generate",
    "prisma:migrate": "bun run --filter backend prisma:migrate"
  }
}
